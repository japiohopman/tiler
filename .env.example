# Tiler Environment Variables Configuration Example
# Copy this file to .env or .env.local to configure local provider credentials.

# Selected Image Generation Provider ('mock', 'gemini', 'pixazo', 'pollinations', or 'huggingface')
# Default if unset: 'mock'
IMAGE_PROVIDER=mock

# Gemini Provider Configuration (Legacy / Optional)
GEMINI_API_KEY=

# Pixazo Provider Configuration (CURRENT VALIDATED PROVIDER CANDIDATE)
# Obtain subscription key from https://www.pixazo.ai/
PIXAZO_API_KEY=
# Alternative configuration name for Pixazo API key:
# PIXAZO_SUBSCRIPTION_KEY=
# Request timeout in milliseconds (default: 30000)
# PIXAZO_TIMEOUT_MS=30000
# PIXAZO_ENDPOINT=https://gateway.pixazo.ai/getImage/v1/getSDXLImage
# PIXAZO_MODEL=sdxl-base-1.0

# Pollinations AI Provider Configuration (Research PoC - Issue #17)
# Obtain API key from https://enter.pollinations.ai/keys
POLLINATIONS_API_KEY=
# POLLINATIONS_ENDPOINT=https://gen.pollinations.ai/image
# POLLINATIONS_MODEL=flux

# Hugging Face Inference Provider Configuration (Research PoC - Issue #18)
# Obtain User Access Token from https://huggingface.co/settings/tokens
HF_TOKEN=
# HUGGINGFACE_API_KEY=
# HF_PROVIDER=fal-ai
# HF_MODEL=black-forest-labs/FLUX.1-schnell
