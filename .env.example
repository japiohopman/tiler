# Tiler Environment Variables Configuration Example
# Copy this file to .env or .env.local to configure local provider credentials.

# Selected Image Generation Provider ('mock', 'gemini', or 'pixazo')
# Default if unset: 'mock'
IMAGE_PROVIDER=mock

# Gemini Provider Configuration
GEMINI_API_KEY=

# Pixazo Provider Configuration (SDXL Base 1.0 PoC - Issue #15)
# Obtain subscription key from https://www.pixazo.ai/
PIXAZO_API_KEY=
# PIXAZO_SUBSCRIPTION_KEY=
# PIXAZO_ENDPOINT=https://gateway.pixazo.ai/getImage/v1/getSDXLImage
# PIXAZO_MODEL=sdxl-base-1.0
